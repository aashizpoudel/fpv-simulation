{
  "name": "drone-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run assets:check && npm run typecheck && vite build",
    "assets:check": "node scripts/check-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "collision:ekotori": "node scripts/build-ekotori-collision.mjs",
    "splat:repack": "node scripts/repack-splat-lod.mjs",
    "physics:benchmark": "node scripts/physics-benchmark.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@sparkjsdev/spark": "^2.1.0",
    "@types/three": "^0.182.0",
    "cesium": "^1.116.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.3.3",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-static-copy": "^0.17.0",
    "vitest": "^1.6.0"
  }
}
