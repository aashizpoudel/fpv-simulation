{
  "name": "drone-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "splat:repack": "node scripts/repack-splat-lod.mjs",
    "prototype:splat:repack": "node scripts/repack-splat-lod.mjs https://code.playcanvas.com/temp/factory/lod-meta.json 6,5 prototypes/splat-lod/public/assets",
    "prototype:splat:dev": "vite --config prototypes/splat-lod/vite.config.ts",
    "prototype:splat:build": "vite build --config prototypes/splat-lod/vite.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@types/three": "^0.182.0",
    "cesium": "^1.116.0",
    "playcanvas": "^2.22.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playcanvas/splat-transform": "^3.3.3",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-static-copy": "^0.17.0",
    "vitest": "^1.6.0"
  }
}
